      "parameters": {
        "jsCode": "const labels = $(\"Get issue\")\n  .first()\n  .json\n  .labels\n  .map(label => label.name);\n\n// \"apply review\" und \"automation:running\" entfernen\nconst filtered = labels.filter(label =>\n  ![\"apply review\", \"automation:running\"].includes(label)\n);\n\n// \"create review\" hinzufügen, falls noch nicht vorhanden\nif (!filtered.includes(\"create review\")) {\n  filtered.push(\"create review\");\n}\n\nreturn [{\n  json: {\n    labels: filtered\n  }\n}];"
      },
