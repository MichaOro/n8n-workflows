      ],
      "id": "e731992f-c62d-4097-a4a2-5263a6ce482a",
      "name": "get issue body"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nif (items.length === 0) {\n  throw new Error('Keine Kommentare vorhanden.');\n}\n\nconst validItems = items.filter(item => {\n  return (\n    item.json &&\n    typeof item.json.created_at === 'string' &&\n    typeof item.json.body === 'string'\n  );\n});\n\nif (validItems.length === 0) {\n  throw new Error('Kein Kommentar mit created_at und body gefunden.');\n}\n\nconst latestItem = validItems.reduce((latest, current) => {\n  const latestTimestamp = Date.parse(latest.json.created_at);\n  const currentTimestamp = Date.parse(current.json.created_at);\n\n  if (!Number.isFinite(currentTimestamp)) {\n    return latest;\n  }\n\n  if (!Number.isFinite(latestTimestamp)) {\n    return current;\n  }\n\n  return currentTimestamp > latestTimestamp\n    ? current\n    : latest;\n});\n\n// Nur der Body des aktuellsten Kommentars wird weitergegeben\nreturn [\n  {\n    json: {\n      review: latestItem.json.body,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        160
      ],
      "id": "691b1360-7a3e-4520-aa02-f0d5d7e187f7",
