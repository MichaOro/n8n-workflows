    {
      "parameters": {
        "jsCode": "const labels = $(\"Get issue\")\n  .first()\n  .json\n  .labels\n  .map(label => label.name);\n\n// \"create review\" und \"automation:running\" entfernen\nconst filtered = labels.filter(label =>\n  ![\"create review\", \"automation:running\"].includes(label)\n);\n\n// \"apply review\" hinzufügen, falls noch nicht vorhanden\nif (!filtered.includes(\"apply review\")) {\n  filtered.push(\"apply review\");\n}\n\nreturn [{\n  json: {\n    labels: filtered\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
