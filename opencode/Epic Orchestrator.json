    {
      "parameters": {
        "jsCode": "const event = $json.headers[\"x-github-event\"];\nconst action = $json.body.action;\n\nconst allowed =\n    (event === \"issues\" && [\"opened\", \"edited\"].includes(action)) ||\n    (event === \"issue_comment\" && action === \"created\");\n\nreturn [{\n    json: {\n        ...$json,\n        allowed\n    }\n}];"
      },
