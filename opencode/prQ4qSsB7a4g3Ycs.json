    {
      "parameters": {
        "jsCode": "const workflowStates = [\n  \"awaiting review\",\n  \"needs refinement\",\n  \"awaiting approval\",\n  \"approved\",\n  \"implementing\",\n  \"completed\",\n];\n\nconst labels = $(\"Get issue\")\n  .first()\n  .json\n  .labels\n  .map(label => label.name);\n\nconst state = labels.find(label => workflowStates.includes(label));\n\nreturn [{\n  json: {\n    ...$json,\n    labels,\n    state,\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
